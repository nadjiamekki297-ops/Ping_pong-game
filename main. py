import pygame
import sys

pygame.init()

WIDTH, HEIGHT = 800, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("ping pong by nadjia")
clock = pygame.time.Clock()
font = pygame.font.SysFont("courier", 32)

# المضارب والكرة
paddle1 = pygame.Rect(30, HEIGHT // 2 - 50, 15, 100)
paddle2 = pygame.Rect(WIDTH - 45, HEIGHT // 2 - 50, 15, 100)
ball = pygame.Rect(WIDTH // 2 - 8, HEIGHT // 2 - 8, 16, 16)

PADDLE_SPEED = 7
ball_dx, ball_dy = 5, 5
score1, score2 = 0, 0
WIN_SCORE = 5
game_over = False
winner = ""

def reset_ball(direction):
    global ball_dx, ball_dy
    ball.center = (WIDTH // 2, HEIGHT // 2)
    ball_dx = 5 * direction
    ball_dy = 5

while True:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()
        if event.type == pygame.KEYDOWN and event.key == pygame.K_SPACE and game_over:
            score1, score2 = 0, 0
            game_over = False
            reset_ball(1)

    if not game_over:
        keys = pygame.key.get_pressed()
        if keys[pygame.K_w] and paddle1.top > 0:
            paddle1.y -= PADDLE_SPEED
        if keys[pygame.K_s] and paddle1.bottom < HEIGHT:
            paddle1.y += PADDLE_SPEED
        if keys[pygame.K_UP] and paddle2.top > 0:
            paddle2.y -= PADDLE_SPEED
        if keys[pygame.K_DOWN] and paddle2.bottom < HEIGHT:
            paddle2.y += PADDLE_SPEED

        ball.x += ball_dx
        ball.y += ball_dy

        # ارتداد من فوق وتحت
        if ball.top <= 0 or ball.bottom >= HEIGHT:
            ball_dy *= -1

        # ضرب المضارب (والكرة تزيد سرعة شوية)
        if ball.colliderect(paddle1) and ball_dx < 0:
            ball_dx = abs(ball_dx) + 0.5
        if ball.colliderect(paddle2) and ball_dx > 0:
            ball_dx = -(abs(ball_dx) + 0.5)

        # النقاط
        if ball.right >= WIDTH:
            score1 += 1
            reset_ball(-1)
        if ball.left <= 0:
            score2 += 1
            reset_ball(1)

        if score1 >= WIN_SCORE:
            game_over, winner = True, "Player 1 wins!"
        if score2 >= WIN_SCORE:
            game_over, winner = True, "Player 2 wins!"

    # الرسم
    screen.fill((0, 0, 0))
    pygame.draw.rect(screen, (0, 120, 255), paddle1)
    pygame.draw.rect(screen, (255, 0, 0), paddle2)
    pygame.draw.ellipse(screen, (255, 255, 255), ball)
    pygame.draw.aaline(screen, (100, 100, 100), (WIDTH // 2, 0), (WIDTH // 2, HEIGHT))

    text = font.render(f"player 1: {score1}   player 2: {score2}", True, (255, 255, 255))
    screen.blit(text, (WIDTH // 2 - text.get_width() // 2, 20))

    if game_over:
        msg = font.render(winner + "  (SPACE = play again)", True, (255, 255, 0))
        screen.blit(msg, (WIDTH // 2 - msg.get_width() // 2, HEIGHT // 2))

    pygame.display.flip()
    clock.tick(60)